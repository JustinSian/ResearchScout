# ---- 数据与模型（体积大、可重建）----
# 注意：不能直接写 `data/`，否则无法再用 ! 放行里面的快照文件
# （git 规则：父目录被忽略时，其子文件无法被重新包含）
data/*
!data/snapshot/
!data/snapshot/demo.db
models/
*.onnx

# 数据库（快照写在后面覆盖，顺序敏感）
*.db
*.db-wal
*.db-shm
!data/snapshot/demo.db

# ---- 运行产物 ----
logs/
data/vfs/
*.log
*.pid
*.jsonl
# 评测集必须入库：否则 clone 下来无法复现 m51/m53 的数字
!eval/*.jsonl

# ---- 一次性运维脚本（历史脚本已归档到 scripts/archive/）----
scripts/_*.sh

# ---- 密钥 ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
