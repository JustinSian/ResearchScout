# ===== ScholarTrust 环境变量示例 =====
# 复制为 .env 后填写；.env 已被 .gitignore 排除，不会进版本库

# 写操作密钥（复核队列、补中文名等接口需要 X-API-Key）
ST_API_KEY=change-me

# OpenAlex API key（免费申请：POST https://api.openalex.org/api-keys，邮件激活）
# 未配置时按无 key 模式运行（1,000 次/天）；配置后 10,000 次/天
ST_OPENALEX_KEY=

# AnySearch 兜底检索 key（可选；不填则库外问题直接拒答）
# 申请：https://anysearch.com/console/api-keys
ANYSEARCH_API_KEY=

# 可选：对外文档（/docs）默认关闭，设为 1 才开启
ST_DOCS_ENABLED=0
