# 复制成 .env 后填写；.env 已在 .gitignore 里，不会进仓库
# 支持任何 OpenAI 兼容端点（OpenAI/DeepSeek/Moonshot/智谱GLM/通义Qwen/OpenRouter/vLLM/Ollama…）

# 必填：模型 API key（Agent 走 LLM；不配则退回规则链路）
LLM_API_KEY=
# 可选：端点与模型（旧名 DEEPSEEK_API_KEY/BASE_URL/MODEL 仍兼容）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 可选：美元/1M tokens（不设则用 DeepSeek 峰值价，宁可高估成本）
LLM_PRICE_INPUT=
LLM_PRICE_OUTPUT=
# 可选：json_object（默认）| text（不支持 response_format 的提供商选 text）
LLM_JSON_MODE=json_object

# 重排模型目录（bge-reranker ONNX，用于"库里到底有没有"的拒答判定）
ST_RERANK_DIR=
# OpenAlex 采集 key（可选；不配走无 key 模式）
ST_OPENALEX_KEY=
# 写接口鉴权 key
ST_API_KEY=
