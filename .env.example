# 复制成 .env 后填写；.env 已在 .gitignore 里，不会进仓库
# 支持任何 OpenAI 兼容端点（OpenAI/DeepSeek/Moonshot/智谱GLM/通义Qwen/OpenRouter/vLLM/Ollama…）

# 必填：模型 API key（Agent 走 LLM；不配则退回规则链路）
LLM_API_KEY=
# 可选：端点与模型（旧名 DEEPSEEK_API_KEY/BASE_URL/MODEL 仍兼容）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 可选：美元/1M tokens（不设则用 DeepSeek 峰值价，宁可高估成本）
LLM_PRICE_INPUT=
LLM_PRICE_OUTPUT=
# 可选：json_object（默认）| text（不支持 response_format 的提供商选 text）
LLM_JSON_MODE=json_object

# 重排模型目录（bge-reranker ONNX，用于"库里到底有没有"的拒答判定）
ST_RERANK_DIR=
# OpenAlex 采集 key（可选；不配走无 key 模式）
ST_OPENALEX_KEY=
# 写接口鉴权 key
ST_API_KEY=
# 读鉴权：1 = 读接口也要求 X-API-Key（公网部署建议开启）
ST_READ_AUTH=0

# 聊天限流（每-IP 令牌桶）
ST_CHAT_BURST=10
ST_CHAT_RPM=30

# 允许模型一轮并行要多个工具（减少 LLM 往返；个别提供商不认会自动回退）
ST_PARALLEL_TOOLS=1
# 本地工具并发执行（默认 0：并发会抢 SQLite 锁，实测单工具 23ms→670ms，得不偿失）
ST_PARALLEL_EXEC=0

# Agent 墙钟上限（秒）：补库等慢路径超过就中止，避免用户无限等待
ST_AGENT_DEADLINE_S=90

# 问答缓存 TTL（秒），0 表示不缓存
ST_CACHE_TTL=86400
